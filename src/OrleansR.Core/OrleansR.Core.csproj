<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>OrleansR.Core</PackageId>
        <Authors>Liam Morrow</Authors>
        <Title>
            OrleansR Core package
        </Title>
        <Description>
            A core package of OrleansR. You likely want one of either `OrleansR.SignalR`, or `OrleansR.OrleansSilo`
        </Description>
        <OutputType>Library</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>default</LangVersion>
    </PropertyGroup>
    <ItemGroup>
        <!-- A library: it needs the ASP.NET Core shared framework (SignalR), not the Web SDK, whose static web
             assets add a hot-reload module that a library without endpoints cannot build on SDK 11. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.1"/>
    </ItemGroup>
</Project>
